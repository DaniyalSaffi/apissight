---
export interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<div class="container" style="padding-top: 2rem;">
  <h1>{title}</h1>
  {intro && <p class="lead" style="font-size:1.15rem;color:var(--ink-700);max-width:46rem;">{intro}</p>}
  <slot />
</div>
