---
import { SITE, href, type LangCode } from "../site.config";
import { en } from "../i18n/en";
import { de } from "../i18n/de";
import { ur } from "../i18n/ur";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  lang?: LangCode;
  dir?: "ltr" | "rtl";
}

const { title, description = SITE.description, lang = "en", dir = "ltr" } = Astro.props;
const pageTitle = `${title} — ${SITE.name}`;
const currentPath = Astro.url.pathname;
const t = lang === "de" ? de : lang === "ur" ? ur : en;

const navItems: Array<{ path: string; label: string }> = [
  { path: "/project", label: t.nav.project },
  { path: "/detector", label: t.nav.detector },
  { path: "/journey", label: t.nav.journey },
  { path: "/partnership", label: t.nav.partnership },
  { path: "/field-work", label: t.nav.fieldWork },
  { path: "/research", label: t.nav.research },
  { path: "/awards", label: t.nav.awards },
  { path: "/team", label: t.nav.team },
  { path: "/models-data", label: t.nav.modelsData },
  { path: "/roadmap", label: t.nav.roadmap },
  { path: "/learn", label: t.nav.learn },
  { path: "/news", label: t.nav.news },
  { path: "/press", label: t.nav.press },
  { path: "/faq", label: t.nav.faq },
  { path: "/contact", label: t.nav.contact },
];

function isCurrent(path: string): boolean {
  const base = import.meta.env.BASE_URL ?? "/";
  const cleanBase = base.endsWith("/") ? base.slice(0, -1) : base;
  const full = `${cleanBase}${path}`;
  return currentPath === full || currentPath === `${full}/`;
}
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!SITE.allowIndexing && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F5A524" />
    <link rel="manifest" href={href("/manifest.webmanifest")} />
    <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
    <link rel="stylesheet" href={href("/css/fonts.css")} />
    <script is:inline>
      // Set theme before paint. Stored choice wins; otherwise follow the system.
      try {
        var stored = localStorage.getItem("apissight-theme");
        var theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      } catch (e) { /* private mode: keep light theme */ }
    </script>
  </head>
  <body data-sw-url={href("/sw.js")}>
    <a class="skip-link" href="#main">{t.chrome.skipLink}</a>
    {SITE.earlyRelease && (
      <aside class="release-banner" aria-label="Release notice">
        {t.releaseBanner}
      </aside>
    )}
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href={href("/")}>
          <svg class="hex-mark" width="40" height="44" viewBox="0 0 40 44" aria-hidden="true">
            <polygon points="20,1 38,11 38,31 20,41 2,31 2,11" fill="#F5A524" stroke="#B97A0F" stroke-width="2" />
            <text x="20" y="29" text-anchor="middle" font-size="20" font-weight="700" fill="#1D1408" font-family="Georgia, serif">A</text>
          </svg>
          <span>
            <span class="brand-name">{SITE.name}</span><br />
            <span class="brand-tag">{SITE.tagline}</span>
          </span>
        </a>
        <div class="header-actions">
          <form class="header-search" role="search" aria-label={t.chrome.quickSearch} action={href("/search")} method="get">
            <label class="visually-hidden" for="header-search-input">{t.chrome.searchLabel}</label>
            <input id="header-search-input" name="q" type="search" placeholder={t.chrome.search} />
            <button type="submit">{t.chrome.search}</button>
          </form>
          <nav class="lang-links" aria-label={t.chrome.langNav}>
            <a href={href("/")} aria-current={lang === "en" ? "page" : undefined}>English</a>
            <a href={href("/de/")} aria-current={lang === "de" ? "page" : undefined}>Deutsch</a>
            <a href={href("/ur/")} aria-current={lang === "ur" ? "page" : undefined}>اردو</a>
          </nav>
          <button class="theme-btn" id="theme-toggle" type="button" aria-label={t.chrome.themeLabel}>{t.chrome.theme}</button>
        </div>
      </div>
      <nav class="main-nav" aria-label={t.chrome.mainNav}>
        <div class="container">
          <ul>
            <li><a href={href("/")} aria-current={isCurrent("/") ? "page" : undefined}>{t.nav.home}</a></li>
            {navItems.map((item) => (
              <li>
                <a href={href(item.path)} aria-current={isCurrent(item.path) ? "page" : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <nav aria-label={t.chrome.footerNav}>
          <ul>
            <li><a href={href("/privacy")}>{t.footer.privacy}</a></li>
            <li><a href={href("/terms")}>{t.footer.terms}</a></li>
            <li><a href={href("/imprint")}>{t.footer.imprint}</a></li>
            <li><a href={href("/faq")}>{t.footer.faq}</a></li>
            <li><a href={href("/contact")}>{t.footer.contact}</a></li>
            <li><a href={href("/credits")}>{t.footer.credits}</a></li>
          </ul>
        </nav>
        <p class="footer-note">
          {t.footer.contactLabel}
          <a href={`mailto:${SITE.contactEmail}`}>{t.footer.email}</a> ·
          {SITE.socials.linkedin && <><a href={SITE.socials.linkedin} rel="noopener">LinkedIn</a> · </>}
          <a href={SITE.whatsapp.chatUrl} rel="noopener">WhatsApp</a>
        </p>
        <p class="footer-note">
          {SITE.name} {t.footer.about} {SITE.disclaimer}
        </p>
        <p class="footer-note small">
          {t.footer.earlyReleaseNote}
        </p>
      </div>
    </footer>
    <script is:inline>
      document.getElementById("theme-toggle").addEventListener("click", function () {
        var root = document.documentElement;
        var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("apissight-theme", next); } catch (e) { /* ignore */ }
      });
    </script>
    <script>
      // Offline support for production builds only. The service worker caches
      // the app shell and the detector page. It never caches uploads or results.
      // The URL comes from a data attribute so this script stays bundled.
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        var swUrl = document.body.getAttribute("data-sw-url");
        if (swUrl) {
          window.addEventListener("load", function () {
            navigator.serviceWorker.register(swUrl).catch(function () { /* offline support is optional */ });
          });
        }
      }
    </script>
  </body>
</html>
