---
import BaseLayout from "../components/BaseLayout.astro";
import { href } from "../site.config";
---

<BaseLayout title="Page not found" description="The page you asked for does not exist.">
  <div class="container" style="padding-top:3rem;">
    <h1>Page not found</h1>
    <p>The page you asked for does not exist, or it moved. Try one of these:</p>
    <ul>
      <li><a href={href("/")}>Home</a></li>
      <li><a href={href("/project")}>Project</a></li>
      <li><a href={href("/detector")}>Detector</a></li>
      <li><a href={href("/faq")}>FAQ</a></li>
      <li><a href={href("/contact")}>Contact</a></li>
    </ul>
  </div>
</BaseLayout>
