---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PlaceholderBox from "../components/PlaceholderBox.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { awards } from "../data/awards";
---

<BaseLayout
  title="Awards"
  description="Awards as stated by the team, shown separately from organiser-confirmed event facts. Certificates to be added."
>
  <PageHeader
    title="Awards"
    intro="Team placings are shown as statements by the project team, never as verified facts. Organiser-confirmed event facts are shown separately, with links, so the two are never mixed."
  >
    <p><StatusBadge kind="pending" label="Certificate to be added" /></p>
  </PageHeader>
  <div class="container">
    {awards.map((award) => (
      <article class="card" style="margin-bottom:1.2rem;">
        <h2 style="margin-top:0;">{award.event}</h2>
        <p><strong>Organiser:</strong> {award.organiser}</p>
        <p><strong>Date:</strong> {award.eventDate}</p>
        <h3>What the organiser publishes</h3>
        <p>{award.organiserFacts}</p>
        <p>
          <a href={award.organiserUrl} rel="noopener">Organiser page (external link)</a>
        </p>
        <h3>Team claim</h3>
        <p>
          {award.teamClaim} <StatusBadge kind="pending" label="Certificate to be added" />
        </p>
        <h3>Still needed</h3>
        <ul>
          {award.openQuestions.map((q) => <li>{q}</li>)}
        </ul>
      </article>
    ))}

    <PlaceholderBox text="certificates, organiser links, and photos for each award, with permission to publish" />
    <p class="muted small">
      No certificate, photo, or organiser result naming this team was found in public sources
      checked on 12 November 2026. That does not prove the team did not place; it means the claims
      stay as team statements until the team supplies its own evidence.
    </p>
  </div>
</BaseLayout>
